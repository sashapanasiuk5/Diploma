<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Security App</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #4f46e5, #7c3aed, #a855f7);
        }

        body {
            background: #f8fafc;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .navbar {
            background: white !important;
            border-bottom: 1px solid #e5e7eb;
        }

        .card {
            border-radius: 16px;
            border: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .form-switch .form-check-input {
            width: 52px;
            height: 28px;
        }

        .section-title {
            color: #4f46e5;
            font-weight: 600;
        }

        .btn-primary-custom {
            background: var(--primary-gradient);
            border: none;
            border-radius: 12px;
        }
    </style>
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-light shadow-sm py-3"
     style="background: white; border-bottom: 1px solid #e5e7eb;">
    <div class="container-fluid px-4">

        <!-- Brand -->
        <a class="navbar-brand fw-bold fs-3" href="/" style="color: #4f46e5;">
            DBGuard
        </a>

        <!-- Menu -->
        <div class="mx-auto d-flex align-items-center gap-5">
            <a class="nav-link fw-semibold fs-5" href="/Rules" style="color: #374151;">Rules</a>

            <div class="vr" style="height: 32px; width: 1.5px; background-color: #8a8ab9;"></div>

            <a class="nav-link fw-semibold fs-5" href="/Alerts" style="color: #374151;">Alerts</a>

            

            @if (User.IsInRole("Root"))
            {
                <div class="vr" style="height: 32px; width: 1.5px; background-color: #8a8ab9;"></div>
                <a class="nav-link fw-semibold fs-5" href="/Users" style="color: #374151;">Users</a>
            }
            
        </div>

        <!-- Right side -->
        <div>
            <a class="nav-link fw-semibold fs-5" href="/Profile" style="color: #374151;">
                <i class="fas fa-user-circle me-2"></i>Profile
            </a>
        </div>

    </div>
</nav>

<div class="container mt-4">
    @RenderBody()
</div>

</body>
</html>