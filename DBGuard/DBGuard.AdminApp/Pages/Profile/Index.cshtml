@page
@model ProfileModel
@{
ViewData["Title"] = "Profile";
Layout = "_Layout";
}

<div class="container py-5">
    <h2 class="mb-5 fw-bold text-center">My Profile</h2>
 
    <div class="row justify-content-center">
        <div class="col-lg-6">   <!-- Made narrower -->

            <div class="card overflow-hidden">

                <!-- Gradient Header -->
                <div class="px-5 pt-5 pb-4 text-center"
                     style="background: linear-gradient(135deg, #4f46e5, #7c3aed); color: white;">

                    <div class="mx-auto mb-3 bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 100px; height: 100px; font-size: 2.6rem;">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>

                    <h3 class="fw-bold mb-1">@Model.Username</h3>
                    <p class="mb-0 opacity-90">@Model.Email</p>
                </div>

                <!-- Content -->
                <div class="p-4 p-md-5">
                    <div class="row text-center g-4 mb-5">
                        <div class="col-6">
                            <div class="small text-muted">Role</div>
                            <div class="fw-semibold">@Model.Role</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted">Status</div>
                            <span class="badge bg-success px-3 py-2">Active</span>
                        </div>
                    </div>

                    <div class="border-top pt-4">
                        <div class="d-flex justify-content-between py-3">
                            <span class="text-muted">Username</span>
                            <span class="fw-medium">@Model.Username</span>
                        </div>
                        <div class="d-flex justify-content-between py-3">
                            <span class="text-muted">Email</span>
                            <span class="fw-medium text-break">@Model.Email</span>
                        </div>
                        <div class="d-flex justify-content-between py-3">
                            <span class="text-muted">Account Type</span>
                            <span class="fw-medium">Administrator</span>
                        </div>
                    </div>
                </div>

                <!-- Button -->
                <div class="p-4 border-top bg-light text-white">
                    <a href="/Profile/Update" class="btn btn-primary-custom w-100 py-3">
                        Update Profile
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>