@page
@model LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #4f46e5, #7c3aed, #a855f7);
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .split-container {
            height: 100vh;
            overflow: hidden;
        }

        .left-panel {
            background: var(--primary-gradient);
            color: white;
            padding: 3.5rem 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            height: 100%;
        }

        .right-panel {
            background: white;
            padding: 3.5rem 3rem;
            display: flex;
            align-items: center;
            height: 100%;
            overflow: hidden;           /* No scrolling */
        }

        .form-card {
            width: 100%;
            max-width: 420px;
            margin: 0 auto;
        }

        .btn-primary-custom {
            background: var(--primary-gradient);
            border: none;
            padding: 14px;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .btn-primary-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 25px rgba(124, 58, 237, 0.35);
        }

        .form-control {
            border-radius: 12px;
            padding: 14px 16px;
            border: 2px solid #e2e8f0;
            font-size: 1rem;
        }

        .form-control:focus {
            border-color: #7c3aed;
            box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.15);
        }
    </style>
</head>
<body>
    <div class="container-fluid split-container p-0">
        <div class="row h-100 g-0">

            <!-- Left Panel -->
            <div class="col-lg-5 left-panel d-none d-lg-flex">
                <div>
                    <i class="fas fa-shield-virus mb-4" style="font-size: 3.5rem; opacity: 0.95;"></i>
                    <h1 class="display-5 fw-bold mb-4">
                        Get access your DBGuard app 
                    </h1>
                    
                    <div class="mt-4 pt-4">
                        <h3 class="opacity-75">Configure rules, watch alerts and manage your DB security</h3>
                    </div>
                </div>
            </div>

            <!-- Right Panel -->
            <div class="col-lg-7 right-panel">
                <div class="form-card">
                    <div class="mb-5 text-center">
                        <h2 class="fw-bold text-dark mb-2">Welcome back</h2>
                        <p class="text-muted">Sign in to continue to your workspace</p>
                    </div>

                    @if (!ModelState.IsValid)
                    {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                    }

                    <form method="post">
                        <div class="mb-4">
                            <label class="form-label fw-medium text-dark">Email or Username</label>
                            <input asp-for="Username" class="form-control" placeholder="your@email.com" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium text-dark">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 text-white mb-4">
                            Sign In
                        </button>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>