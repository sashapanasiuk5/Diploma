@page
@model SetRootPasswordModel
@{
Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set Root Password</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #4f46e5, #7c3aed, #a855f7);
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f8fafc, #e0e7ff);
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .full-container {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            border: none;
            max-width: 460px;
            width: 100%;
        }

        .btn-primary-custom {
            background: var(--primary-gradient);
            border: none;
            padding: 14px;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.3s;
        }

        .btn-primary-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 25px rgba(124, 58, 237, 0.4);
        }

        .form-control {
            border-radius: 12px;
            padding: 14px 16px;
            border: 2px solid #e2e8f0;
        }

        .form-control:focus {
            border-color: #7c3aed;
            box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.15);
        }
    </style>
</head>
<body>
<div class="full-container">
    <div class="card p-5">
        <div class="text-center mb-5">
            <i class="fas fa-shield-alt" style="font-size: 3rem; color: #7c3aed;"></i>
            <h2 class="fw-bold mt-3">Set Root Password</h2>
            <p class="text-muted">This password will be used for administrator access</p>
        </div>

        <form method="post">
            <div class="mb-4">
                <label class="form-label fw-medium">New Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter strong password" />
            </div>

            <div class="mb-5">
                <label class="form-label fw-medium">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password" />
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 text-white">
                Save Password
            </button>
        </form>

        <div class="text-center mt-4">
            <small class="text-muted">
                Make sure your password is strong and memorable
            </small>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>