@using DBGuard.Common.Extensions
@model DBGuard.Contracts.Models.AlertEmailModel
@{
Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f8fafc; margin: 0; padding: 20px; }
        .container { max-width: 780px; margin: 0 auto; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.1); }
        .header { background: linear-gradient(135deg, #4f46e5, #7c3aed); color: white; padding: 30px; text-align: center; }
        .header h2 { margin: 0 0 8px 0; font-size: 26px; }
        .content { padding: 30px; }
        .title { color: #ef4444; font-size: 20px; font-weight: 600; margin-bottom: 8px; }
        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        th {
            background: #f1f5f9;
            padding: 14px 12px;
            text-align: left;
            font-weight: 600;
            color: #374151;
        }
        td {
            padding: 16px 12px;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: middle;
        }
        .badge {
            background: #ef4444;
            color: white;
            padding: 5px 12px;
            border-radius: 9999px;
            font-size: 13.5px;
            font-weight: 600;
            display: inline-block;
            white-space: nowrap;
        }
        .time { color: #64748b; font-size: 15px; }
        .footer { background: #f8fafc; padding: 25px; text-align: center; color: #64748b; font-size: 14px; }
        code { background: #f1f5f9; padding: 3px 7px; border-radius: 4px; font-size: 14px; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h2>Security Alert</h2>
        <p>DBGuard Protection System</p>
    </div>

    <div class="content">
        <p class="title">@Model.TotalAlerts new suspicious @(Model.TotalAlerts == 1 ? "activity" : "activities") detected</p>
        <p class="time"><strong>Time:</strong> @Model.SentAt.ToString("dddd, MMMM dd, yyyy HH:mm:ss")</p>

        <table>
            <thead>
            <tr>
                <th style="width: 12%;">Time</th>
                <th style="width: 18%;">Type</th>
                <th style="width: 38%;">Description</th>
                <th style="width: 17%;">Username</th>
                <th style="width: 15%;">IP Address</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var alert in Model.Alerts)
            {
            <tr>
                <td><strong>@alert.CreatedAt.ToString("HH:mm:ss")</strong></td>
                <td><span class="badge">@alert.Type.GetTextRepresentation()</span></td>
                <td>@alert.Description</td>
                <td>@if(string.IsNullOrWhiteSpace(alert.Username))
                    {
                        <span style='color:#9ca3af'>-</span>
                    }
                    else
                    {
                        @alert.Username;
                    }
                </td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(alert.IpAddress))
                    {
                    <code>@alert.IpAddress</code>
                    }
                    else
                    {
                    <span>-</span>
                    }
                </td>
            </tr>
            }
            </tbody>
        </table>

        <div style="background:#fefce8; border:1px solid #fde047; padding:20px; border-radius:8px; margin-top:25px;">
            <strong>Recommendation:</strong> Please review these alerts in the DBGuard dashboard and take necessary action.
        </div>
    </div>

    <div class="footer">
        This is an automated security notification from <strong>DBGuard</strong><br>
        © @DateTime.Now.Year DBGuard Security System
    </div>
</div>
</body>
</html>